#!/bin/sh
# Runs lib/launchpad.py with the first Python on PATH that is 3.11 or newer.
# macOS's own /usr/bin/python3 is older, so a bare python3 isn't enough.

root=${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}

for py in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$py" >/dev/null 2>&1 &&
    "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$py" "$root/lib/launchpad.py" "$@"
  fi
done

echo "launchpad: needs Python 3.11 or newer on PATH" >&2
if [ -t 0 ]; then
  printf '\npress enter to close'
  read -r _
fi
exit 1
